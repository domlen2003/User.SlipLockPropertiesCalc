<UserControl x:Class="User.SlipLockPropertiesCalc.UI.Controls.LevelMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:conv="clr-namespace:User.SlipLockPropertiesCalc.UI.Converters"
             x:Name="Root"
             mc:Ignorable="d"
             d:DesignWidth="160">
    <!-- Horizontal live bar with its numeric value; binds only to its own dependency properties (no DataContext use). -->
    <UserControl.Resources>
        <conv:NumberFormatConverter x:Key="NumberFormat" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ProgressBar Height="{Binding BarHeight, ElementName=Root}"
                     VerticalAlignment="Center"
                     Minimum="0"
                     Maximum="{Binding Maximum, ElementName=Root}"
                     Value="{Binding Value, ElementName=Root, Mode=OneWay}" />
        <TextBlock Grid.Column="1"
                   MinWidth="{Binding ValueWidth, ElementName=Root}"
                   Margin="6,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="Consolas"
                   TextAlignment="Right">
            <TextBlock.Text>
                <MultiBinding Converter="{StaticResource NumberFormat}">
                    <Binding Path="Value" ElementName="Root" />
                    <Binding Path="ValueFormat" ElementName="Root" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
    </Grid>
</UserControl>
