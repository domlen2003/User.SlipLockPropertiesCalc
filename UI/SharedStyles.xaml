<ResourceDictionary x:Class="DivebombLogistics.UI.SharedStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
                    xmlns:vm="clr-namespace:DivebombLogistics.UI.ViewModels"
                    xmlns:conv="clr-namespace:DivebombLogistics.UI.Converters">
    <!--
        Look shared by every DLP tab (Haptics, Speed Dial): merged into each view's resources by instantiating this
        class (no pack URI). Colors come from the SimHub theme; secondary text is dimmed with Opacity so it works in
        light and dark themes. A view keeps only the resources that are its own.
    -->
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:TextToVisibilityConverter x:Key="TextToVisibility" />

    <!-- ===== Spacing ===== -->
    <Thickness x:Key="ButtonSpacing">0,0,8,8</Thickness>
    <Thickness x:Key="BlockSpacing">0,0,0,12</Thickness>

    <!-- ===== Text styles ===== -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,2,0,8" />
    </Style>
    <Style x:Key="StatusMessage" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <!-- Call-to-action banner: accent bar on the left, theme background untouched. -->
    <Style x:Key="HintBanner" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="CaptionText" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="ValueText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="NumberCell" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,16,0" />
    </Style>
    <!-- Read-only, selectable text (paths, errors) so values can be copied; based on the themed TextBox style. -->
    <Style x:Key="CopyableText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontFamily" Value="Consolas" />
    </Style>
    <Style x:Key="MultiLineText" TargetType="TextBox" BasedOn="{StaticResource CopyableText}">
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="MaxHeight" Value="240" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ===== Panels ===== -->
    <ItemsPanelTemplate x:Key="TwoColumnPanel">
        <UniformGrid Columns="2" />
    </ItemsPanelTemplate>

    <!-- ===== Item templates ===== -->
    <!-- Minimum/Maximum are bound before Value so the slider never clamps (and writes back) a value against default limits. -->
    <DataTemplate x:Key="SliderItemTemplate" DataType="{x:Type vm:SliderItem}">
        <ui:TitledSlider Margin="0,0,16,6"
                         Title="{Binding Title}"
                         InformationTooltip="{Binding Help}"
                         Minimum="{Binding Minimum}"
                         Maximum="{Binding Maximum}"
                         TickFrequency="{Binding Step}"
                         InputInterval="{Binding Step}"
                         IsSnapToTickEnabled="True"
                         StringFormat="{Binding Format}"
                         ShowResetButton="True"
                         ResetValue="{Binding DefaultValue}"
                         Value="{Binding Value}" />
    </DataTemplate>
</ResourceDictionary>
