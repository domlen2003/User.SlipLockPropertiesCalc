<UserControl x:Class="User.SlipLockPropertiesCalc.UI.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
             xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
             xmlns:local="clr-namespace:User.SlipLockPropertiesCalc.UI"
             xmlns:controls="clr-namespace:User.SlipLockPropertiesCalc.UI.Controls"
             xmlns:vm="clr-namespace:User.SlipLockPropertiesCalc.UI.ViewModels"
             xmlns:conv="clr-namespace:User.SlipLockPropertiesCalc.UI.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:SettingsViewModel, IsDesignTimeCreatable=True}"
             d:DesignWidth="960">
    <!--
        Simple view (always visible): status, per-car sensitivities, profile setup, debug switch.
        Debug view (hidden by default): tabs Slip / Lock, Balance, Diagnostics.
        Colors come from the SimHub theme (no hardcoded brushes); secondary text is dimmed with Opacity so it works
        in light and dark themes.
    -->
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:TextToVisibilityConverter x:Key="TextToVisibility" />

        <!-- ===== Spacing ===== -->
        <Thickness x:Key="ButtonSpacing">0,0,8,8</Thickness>
        <Thickness x:Key="BlockSpacing">0,0,0,12</Thickness>
        <Thickness x:Key="QuadSpacing">12,0,12,8</Thickness>
        <!-- Fixed widths: star columns collapse to 0 inside auto-sized (left-aligned / wrapping) lists. -->
        <GridLength x:Key="LevelBarWidth">300</GridLength>
        <GridLength x:Key="SensitivityMeterWidth">220</GridLength>

        <!-- ===== Text styles ===== -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,8" />
        </Style>
        <Style x:Key="StatusMessage" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="FontStyle" Value="Italic" />
        </Style>
        <!-- Call-to-action banner: accent bar on the left, theme background untouched. -->
        <Style x:Key="HintBanner" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="GroupHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,8,0,6" />
        </Style>
        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="ValueText" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="NumberCell" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>
        <!-- Read-only, selectable text (paths, errors) so values can be copied; based on the themed TextBox style. -->
        <Style x:Key="CopyableText" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>
        <Style x:Key="MultiLineText" TargetType="TextBox" BasedOn="{StaticResource CopyableText}">
            <Setter Property="MinHeight" Value="48" />
            <Setter Property="MaxHeight" Value="240" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!-- ===== Panels ===== -->
        <ItemsPanelTemplate x:Key="InfoPanel">
            <WrapPanel ItemWidth="330" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="TwoColumnPanel">
            <UniformGrid Columns="2" />
        </ItemsPanelTemplate>

        <!-- ===== Item templates ===== -->
        <DataTemplate x:Key="InfoItemTemplate" DataType="{x:Type vm:InfoItem}">
            <Grid Margin="0,2,16,2" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Value}" ToolTip="{Binding Value}" />
            </Grid>
        </DataTemplate>

        <!-- Full-width row (identity values such as long car ids). -->
        <DataTemplate x:Key="WideInfoItemTemplate" DataType="{x:Type vm:InfoItem}">
            <Grid Margin="0,2,16,2" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Style="{StaticResource ValueText}" Text="{Binding Value}" ToolTip="{Binding Value}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CopyableInfoItemTemplate" DataType="{x:Type vm:InfoItem}">
            <Grid Margin="0,1" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Top" Text="{Binding Label}" />
                <TextBox Grid.Column="1" Style="{StaticResource CopyableText}" Text="{Binding Value, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="LevelItemTemplate" DataType="{x:Type vm:LevelItem}">
            <Grid Margin="0,3" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="{StaticResource LevelBarWidth}" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Label}" />
                <controls:LevelMeter Grid.Column="1"
                                     Maximum="{Binding Maximum}"
                                     ValueFormat="{Binding Format}"
                                     Value="{Binding Value}" />
            </Grid>
        </DataTemplate>

        <!-- Minimum/Maximum are bound before Value so the slider never clamps (and writes back) a value against default limits. -->
        <DataTemplate x:Key="SliderItemTemplate" DataType="{x:Type vm:SliderItem}">
            <ui:TitledSlider Margin="0,0,16,6"
                             Title="{Binding Title}"
                             InformationTooltip="{Binding Help}"
                             Minimum="{Binding Minimum}"
                             Maximum="{Binding Maximum}"
                             TickFrequency="{Binding Step}"
                             InputInterval="{Binding Step}"
                             IsSnapToTickEnabled="True"
                             StringFormat="{Binding Format}"
                             ShowResetButton="True"
                             ResetValue="{Binding DefaultValue}"
                             Value="{Binding Value}" />
        </DataTemplate>

        <DataTemplate x:Key="SliderGridTemplate" DataType="{x:Type vm:SliderGroup}">
            <ItemsControl Focusable="False"
                          ItemsPanel="{StaticResource TwoColumnPanel}"
                          ItemTemplate="{StaticResource SliderItemTemplate}"
                          ItemsSource="{Binding Items}" />
        </DataTemplate>

        <DataTemplate x:Key="SliderGroupTemplate" DataType="{x:Type vm:SliderGroup}">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Style="{StaticResource GroupHeader}" Text="{Binding Title}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource SliderGridTemplate}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SensitivityItemTemplate" DataType="{x:Type vm:SensitivityItem}">
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="SensitivitySlider" />
                    <ColumnDefinition Width="{StaticResource SensitivityMeterWidth}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ui:TitledSlider MinWidth="460"
                                 IsEnabled="{Binding IsAvailable}"
                                 Title="{Binding Title}"
                                 TitleTooltip="{Binding Help}"
                                 Minimum="{Binding Minimum}"
                                 Maximum="{Binding Maximum}"
                                 TickFrequency="{Binding SnapStep}"
                                 InputInterval="{Binding SnapStep}"
                                 IsSnapToTickEnabled="True"
                                 StringFormat="0"
                                 ShowResetButton="True"
                                 ResetValue="{Binding DefaultValue}"
                                 Value="{Binding Value}" />
                <controls:LevelMeter Grid.Column="1"
                                     Margin="16,0,0,0"
                                     VerticalAlignment="Center"
                                     BarHeight="12"
                                     ToolTip="{Binding LevelToolTip}"
                                     Value="{Binding Level}" />
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource HintText}" Text="{Binding HintText}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OverrideItemTemplate" DataType="{x:Type vm:OverrideItem}">
            <StackPanel Margin="0,0,16,6">
                <ui:TitledSlider ShowCheckbox="True"
                                 IsChecked="{Binding IsEnabled}"
                                 Title="{Binding Title}"
                                 InformationTooltip="{Binding Help}"
                                 Minimum="{Binding Minimum}"
                                 Maximum="{Binding Maximum}"
                                 TickFrequency="{Binding Step}"
                                 InputInterval="{Binding Step}"
                                 IsSnapToTickEnabled="True"
                                 StringFormat="{Binding Format}"
                                 Value="{Binding Value}" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="{Binding InUseText}"
                           Visibility="{Binding InUseText, Converter={StaticResource TextToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ParameterRowTemplate" DataType="{x:Type vm:ParameterItem}">
            <Grid Margin="0,2" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="ParamName" />
                    <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="ParamValue" />
                    <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="ParamSource" />
                    <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="ParamConfidence" />
                    <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="ParamSamples" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,0,16,0" Text="{Binding Name}" />
                <TextBlock Grid.Column="1" Style="{StaticResource NumberCell}" FontWeight="SemiBold" Text="{Binding Value}" />
                <TextBlock Grid.Column="2" Style="{StaticResource NumberCell}" Text="{Binding Source}" />
                <TextBlock Grid.Column="3" Style="{StaticResource NumberCell}" Text="{Binding Confidence}" />
                <TextBlock Grid.Column="4" Style="{StaticResource NumberCell}" Text="{Binding Samples}" />
            </Grid>
        </DataTemplate>

        <!-- ===== Item lists ===== -->
        <Style x:Key="InfoGrid" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="{StaticResource BlockSpacing}" />
            <Setter Property="ItemsPanel" Value="{StaticResource InfoPanel}" />
            <Setter Property="ItemTemplate" Value="{StaticResource InfoItemTemplate}" />
        </Style>
        <!-- One group of an info grid: tighter spacing; every group starts a new row. -->
        <Style x:Key="InfoGroup" TargetType="ItemsControl" BasedOn="{StaticResource InfoGrid}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="WideInfoList" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="ItemTemplate" Value="{StaticResource WideInfoItemTemplate}" />
        </Style>
        <Style x:Key="LevelList" TargetType="ItemsControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="{StaticResource BlockSpacing}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="ItemTemplate" Value="{StaticResource LevelItemTemplate}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,16">

            <!-- ================================ SIMPLE VIEW ================================ -->

            <styles:SHSection Title="SLIP LOCK CALC" ShowSeparator="True">
                <StackPanel>
                    <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap">
                        <Run Text="{Binding GameText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding CarText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Margin="0,4,0,8"
                               TextWrapping="Wrap"
                               Visibility="{Binding ShowSourceStatus, Converter={StaticResource BoolToVisibility}}">
                        <Run Text="{Binding SlipStatusText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding LockStatusText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding BalanceStatusText, Mode=OneWay}" />
                    </TextBlock>
                    <!-- Not styles:SHInlineInfo: its Text property is registered for another owner and cannot be bound. -->
                    <Border Style="{StaticResource HintBanner}"
                            Visibility="{Binding StatusHint, Converter={StaticResource TextToVisibility}}">
                        <TextBlock Text="{Binding StatusHint}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection Title="SENSITIVITY" ShowSeparator="True">
                <StackPanel HorizontalAlignment="Left" Grid.IsSharedSizeScope="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SensitivitySlider" />
                            <ColumnDefinition Width="{StaticResource SensitivityMeterWidth}" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HintText}" Text="{Binding SensitivityCarText}" />
                        <TextBlock Grid.Column="1"
                                   Margin="16,2,0,8"
                                   Style="{StaticResource CaptionText}"
                                   Text="Live output"
                                   ToolTip="Current level (0-100) of the channel each sensitivity scales." />
                    </Grid>
                    <ItemsControl Focusable="False"
                                  IsEnabled="{Binding CanEditCar}"
                                  ItemTemplate="{StaticResource SensitivityItemTemplate}"
                                  ItemsSource="{Binding Sensitivities}" />
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection Title="SETUP" ShowSeparator="True">
                <StackPanel>
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Create the ShakeIT profiles once. They are saved in Documents\SimHub: import them in ShakeIT, then restart SimHub." />
                    <WrapPanel>
                        <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                  Command="{Binding GenerateDataExportProfileCommand}"
                                                  ToolTip="SlipLock_DataExport.siprofile: makes ShakeIT export its wheel slip / lock data for this plugin (needed for most games).">
                            ShakeIT data export
                        </styles:SHButtonSecondary>
                        <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                  Command="{Binding GenerateHapticPedalProfileCommand}"
                                                  ToolTip="SlipLock_HapticPedals.siprofile: slip on the throttle pedal, lock on the brake pedal (ShakeIT Motors).">
                            Haptic pedal profile
                        </styles:SHButtonSecondary>
                        <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                  Command="{Binding GenerateBalanceProfileCommand}"
                                                  ToolTip="SlipLock_Balance.siprofile: understeer on the front corners, oversteer on the rear corners.">
                            Balance haptics profile
                        </styles:SHButtonSecondary>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource StatusMessage}"
                               Text="{Binding SetupStatus}"
                               Visibility="{Binding SetupStatus, Converter={StaticResource TextToVisibility}}" />
                </StackPanel>
            </styles:SHSection>

            <styles:SHSection x:Name="DebugSection" Title="DEBUG" ShowSeparator="True">
                <StackPanel>
                    <styles:SHToggleCheckbox IsChecked="{Binding ShowDebugView}" Checked="OnShowDebugViewChecked">Show debug view</styles:SHToggleCheckbox>
                    <TextBlock Style="{StaticResource HintText}" Text="Signal pipeline internals, advanced tuning and diagnostics." />

                    <!-- ================================ DEBUG VIEW ================================ -->
                    <styles:SHTabControl Margin="0,4,0,0"
                                         SelectedValuePath="Tag"
                                         SelectedValue="{Binding SelectedDebugTab}"
                                         Visibility="{Binding ShowDebugView, Converter={StaticResource BoolToVisibility}}">

                        <!-- ============================ Slip / Lock ============================ -->
                        <styles:SHTabItem Header="Slip / Lock" Tag="{x:Static local:DebugTab.SlipLock}">
                            <StackPanel Margin="0,8,0,0">
                                <styles:SHSubSection Title="Data source and capabilities">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding SourceIdentityInfo}" Style="{StaticResource WideInfoList}" />
                                        <ItemsControl ItemsSource="{Binding SourceSlipInfo}" Style="{StaticResource InfoGroup}" />
                                        <ItemsControl ItemsSource="{Binding SourceAbsInfo}" Style="{StaticResource InfoGroup}" />
                                        <ItemsControl ItemsSource="{Binding SourceTcInfo}" Style="{StaticResource InfoGroup}" />
                                        <ItemsControl ItemsSource="{Binding SourceAggregateInfo}" Style="{StaticResource InfoGroup}" />
                                        <ItemsControl ItemsSource="{Binding SourceMaxGInfo}" Style="{StaticResource InfoGrid}" />
                                        <StackPanel Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource GroupHeader}" Text="Per-wheel speed detection (drive, corner or brake)" />
                                            <ItemsControl ItemsSource="{Binding DetectionConditions}" Style="{StaticResource InfoGroup}" />
                                            <ItemsControl ItemsSource="{Binding DetectionResult}" Style="{StaticResource InfoGrid}" />
                                        </StackPanel>
                                        <styles:SHToggleCheckbox IsChecked="{Binding UseShakeItWheelLock}"
                                                                 ToolTip="Lock = max(synthesized lock, ShakeIT WheelLock) when ShakeIT exports WheelLock.">
                                            Merge ShakeIT WheelLock into the lock channel
                                        </styles:SHToggleCheckbox>
                                        <WrapPanel Margin="0,8,0,0">
                                            <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                                      Command="{Binding RetestCommand}"
                                                                      ToolTip="Forget the stored per-wheel speed result for this game and detect again. Also re-verifies the steering direction used for understeer/oversteer.">
                                                Retest per-wheel detection
                                            </styles:SHButtonSecondary>
                                        </WrapPanel>
                                    </StackPanel>
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Final outputs (SlipTC / LockABS aggregates)">
                                    <WrapPanel HorizontalAlignment="Center">
                                        <controls:WheelQuad Margin="{StaticResource QuadSpacing}" BarWidth="36" BarHeight="50" ValueFormat="0.0"
                                                            Title="{Binding SlipTcTitle}" Values="{Binding SlipTc}" />
                                        <controls:WheelQuad Margin="{StaticResource QuadSpacing}" BarWidth="36" BarHeight="50" ValueFormat="0.0"
                                                            Title="{Binding LockAbsTitle}" Values="{Binding LockAbs}" />
                                    </WrapPanel>
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="{Binding EnvelopeSliders.Title}">
                                    <ContentControl Content="{Binding EnvelopeSliders}" ContentTemplate="{StaticResource SliderGridTemplate}" Focusable="False" />
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="{Binding BlendSliders.Title}">
                                    <StackPanel>
                                        <ContentControl Content="{Binding BlendSliders}" ContentTemplate="{StaticResource SliderGridTemplate}" Focusable="False" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <styles:SHToggleCheckbox Margin="0,0,24,0" IsChecked="{Binding GateSlipOnThrottle}">Gate: zero Slip/TC without throttle</styles:SHToggleCheckbox>
                                            <styles:SHToggleCheckbox IsChecked="{Binding GateLockOnBrake}">Gate: zero Lock/ABS without brake</styles:SHToggleCheckbox>
                                        </WrapPanel>
                                        <WrapPanel HorizontalAlignment="Center">
                                            <controls:WheelQuad Margin="{StaticResource QuadSpacing}" Title="Slip × throttle" Values="{Binding SlipBlend}" />
                                            <controls:WheelQuad Margin="{StaticResource QuadSpacing}" Title="Lock × brake" Values="{Binding LockBlend}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Thresholds and preprocessor output">
                                    <StackPanel>
                                        <ContentControl Content="{Binding ThresholdSliders}" ContentTemplate="{StaticResource SliderGridTemplate}" Focusable="False" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="Preprocessor output: after corner load, speed fade and pre-cut, before thresholds and envelopes." />
                                        <WrapPanel HorizontalAlignment="Center">
                                            <controls:WheelQuad Margin="{StaticResource QuadSpacing}" BarHeight="32" Title="Slip" Values="{Binding Slip}" />
                                            <controls:WheelQuad Margin="{StaticResource QuadSpacing}" BarHeight="32" Title="Lock" Values="{Binding Lock}" />
                                            <controls:WheelQuad Margin="{StaticResource QuadSpacing}" BarHeight="32" Title="ABS" Values="{Binding Abs}" />
                                            <controls:WheelQuad Margin="{StaticResource QuadSpacing}" BarHeight="32" Title="TC" Values="{Binding Tc}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Raw base input and corner load">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource HintText}" Text="{Binding BaseSlipModeText}" />
                                        <WrapPanel>
                                            <ItemsControl Margin="0,0,24,8" ItemsSource="{Binding BaseMonoLevels}" Style="{StaticResource LevelList}" />
                                            <controls:WheelQuad Margin="{StaticResource QuadSpacing}" Minimum="{Binding BaseSlipMinimum}" Maximum="100" ValueFormat="0.0"
                                                                Title="Base slip per wheel" Values="{Binding BaseSlip}" />
                                            <controls:WheelQuad Margin="{StaticResource QuadSpacing}" Maximum="50" ValueFormat="0.0"
                                                                Title="Corner load (proxyL)" Values="{Binding Loads}"
                                                                ToolTip="Estimated corner load, 0..50 with 25 = neutral. Tuned per game preset." />
                                        </WrapPanel>
                                    </StackPanel>
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Game preset (read-only)">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding PresetInfo}" Style="{StaticResource InfoGrid}" />
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="Game presets are defined in code (SlipLock/GamePresets.cs) so the calculation stays reproducible; change them there for future tuning." />
                                    </StackPanel>
                                </styles:SHSubSection>

                                <WrapPanel Margin="0,8,0,0">
                                    <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                              Command="{Binding ResetSlipLockTuningCommand}"
                                                              ToolTip="Restore envelope, blend, threshold, gate and WheelLock settings to their defaults.">
                                        Reset sliders to defaults
                                    </styles:SHButtonSecondary>
                                </WrapPanel>
                            </StackPanel>
                        </styles:SHTabItem>

                        <!-- ============================ Balance ============================ -->
                        <styles:SHTabItem Header="Balance" Tag="{x:Static local:DebugTab.Balance}">
                            <StackPanel Margin="0,8,0,0">
                                <styles:SHSubSection Title="Outputs">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding BalanceOutputLevels}" Style="{StaticResource LevelList}" />
                                        <ItemsControl ItemsSource="{Binding BalanceStateInfo}" Style="{StaticResource InfoGrid}" />
                                    </StackPanel>
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Detectors (raw, before shaping)">
                                    <ItemsControl ItemsSource="{Binding DetectorLevels}" Style="{StaticResource LevelList}" />
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Signals">
                                    <ItemsControl ItemsSource="{Binding SignalInfo}" Style="{StaticResource InfoGrid}" />
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Vehicle model">
                                    <StackPanel Margin="{StaticResource BlockSpacing}" Grid.IsSharedSizeScope="True">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="150" SharedSizeGroup="ParamName" />
                                                <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="ParamValue" />
                                                <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="ParamSource" />
                                                <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="ParamConfidence" />
                                                <ColumnDefinition Width="Auto" MinWidth="100" SharedSizeGroup="ParamSamples" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource CaptionText}" Text="Parameter" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="Value" />
                                            <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="Source" />
                                            <TextBlock Grid.Column="3" Style="{StaticResource CaptionText}" Text="Confidence" />
                                            <TextBlock Grid.Column="4" Style="{StaticResource CaptionText}" Text="Samples" />
                                        </Grid>
                                        <ItemsControl Focusable="False" ItemTemplate="{StaticResource ParameterRowTemplate}" ItemsSource="{Binding Parameters}" />
                                    </StackPanel>
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Learning">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding LearningInfo}" Style="{StaticResource InfoGrid}" />
                                        <styles:SHToggleCheckbox IsChecked="{Binding LearningLocked}"
                                                                 IsEnabled="{Binding HasCar}"
                                                                 ToolTip="Keeps the stored vehicle model of this car unchanged. Per-session adaptation still runs.">
                                            Lock learning for this car
                                        </styles:SHToggleCheckbox>
                                        <WrapPanel Margin="0,8,0,0">
                                            <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                                      Command="{Binding ResetLearningCommand}"
                                                                      ToolTip="Forget the learned vehicle model of this car and start learning again. The steering direction of this sim is verified again too.">
                                                Reset learned model...
                                            </styles:SHButtonSecondary>
                                        </WrapPanel>
                                    </StackPanel>
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Mode and per-car overrides">
                                    <StackPanel>
                                        <Grid Margin="{StaticResource BlockSpacing}" HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="340" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Style="{StaticResource CaptionText}" Text="Estimation mode (all cars)" />
                                            <ComboBox Grid.Column="1"
                                                      Margin="0,0,0,6"
                                                      DisplayMemberPath="Text"
                                                      ItemsSource="{Binding BalanceModes}"
                                                      SelectedItem="{Binding SelectedBalanceMode}" />
                                            <TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Text="Class preset (this car)" />
                                            <ComboBox Grid.Row="1"
                                                      Grid.Column="1"
                                                      DisplayMemberPath="Text"
                                                      IsEnabled="{Binding HasCar}"
                                                      ItemsSource="{Binding ClassPresets}"
                                                      SelectedItem="{Binding SelectedClassPreset}"
                                                      ToolTip="Car-class defaults for the vehicle model and body-slip margins. Auto detects them from the car class." />
                                        </Grid>
                                        <TextBlock Style="{StaticResource HintText}"
                                                   Text="Overrides are saved for this car. Tick a box to replace the learned/default value; while unticked the slider follows the value in use." />
                                        <ItemsControl Focusable="False"
                                                      IsEnabled="{Binding HasCar}"
                                                      ItemsPanel="{StaticResource TwoColumnPanel}"
                                                      ItemTemplate="{StaticResource OverrideItemTemplate}"
                                                      ItemsSource="{Binding Overrides}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                                      Command="{Binding ExportCarProfileCommand}"
                                                                      ToolTip="Save this car's sensitivities, overrides and learned model to a file.">
                                                Export car profile...
                                            </styles:SHButtonSecondary>
                                            <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                                      Command="{Binding ImportCarProfileCommand}"
                                                                      ToolTip="Load sensitivities, overrides and learned model from a file into this car.">
                                                Import car profile...
                                            </styles:SHButtonSecondary>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource StatusMessage}"
                                                   Text="{Binding CarProfileStatus}"
                                                   Visibility="{Binding CarProfileStatus, Converter={StaticResource TextToVisibility}}" />
                                    </StackPanel>
                                </styles:SHSubSection>

                                <styles:SHExpander Margin="0,8,0,0" Header="Detector tuning (global, all cars)">
                                    <StackPanel Margin="0,8,0,0">
                                        <ItemsControl Focusable="False" ItemTemplate="{StaticResource SliderGroupTemplate}" ItemsSource="{Binding BalanceTuningGroups}" />
                                        <WrapPanel>
                                            <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                                      Command="{Binding ResetBalanceTuningCommand}"
                                                                      ToolTip="Restore every detector tuning value (and the estimation mode) to its default.">
                                                Reset tuning to defaults
                                            </styles:SHButtonSecondary>
                                        </WrapPanel>
                                    </StackPanel>
                                </styles:SHExpander>
                            </StackPanel>
                        </styles:SHTabItem>

                        <!-- ============================ Diagnostics ============================ -->
                        <styles:SHTabItem Header="Diagnostics" Tag="{x:Static local:DebugTab.Diagnostics}">
                            <StackPanel Margin="0,8,0,0">
                                <styles:SHSubSection Title="Identity and data paths">
                                    <ItemsControl Margin="{StaticResource BlockSpacing}"
                                                  Focusable="False"
                                                  ItemTemplate="{StaticResource CopyableInfoItemTemplate}"
                                                  ItemsSource="{Binding DiagnosticsInfo}" />
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Balance property resolution">
                                    <TextBox Margin="{StaticResource BlockSpacing}" Style="{StaticResource MultiLineText}" Text="{Binding BalanceResolution, Mode=OneWay}" />
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Last error">
                                    <TextBox Margin="{StaticResource BlockSpacing}" Style="{StaticResource MultiLineText}" Text="{Binding LastError, Mode=OneWay}" />
                                </styles:SHSubSection>
                                <styles:SHSectionSeparator />

                                <styles:SHSubSection Title="Tools">
                                    <StackPanel>
                                        <styles:SHToggleCheckbox IsChecked="{Binding DebugFileLog}"
                                                                 ToolTip="Writes a once-per-second diagnostic line to Logs\SlipLock_debug.log.">
                                            Write debug log file
                                        </styles:SHToggleCheckbox>
                                        <styles:SHToggleCheckbox IsChecked="{Binding IsRecording}"
                                                                 ToolTip="Records balance telemetry to a CSV file for offline analysis/replay.">
                                            Record balance telemetry (CSV)
                                        </styles:SHToggleCheckbox>
                                        <TextBox Style="{StaticResource CopyableText}"
                                                 Margin="0,2,0,8"
                                                 Text="{Binding RecordingPath, Mode=OneWay}"
                                                 Visibility="{Binding RecordingPath, Converter={StaticResource TextToVisibility}}" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <styles:SHButtonSecondary Margin="{StaticResource ButtonSpacing}"
                                                                      Command="{Binding DumpPropertyNamesCommand}"
                                                                      ToolTip="Writes every SimHub property name (incl. raw game data) with current candidate values to a text file.">
                                                Dump property names
                                            </styles:SHButtonSecondary>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource StatusMessage}"
                                                   Text="{Binding DiagnosticsStatus}"
                                                   Visibility="{Binding DiagnosticsStatus, Converter={StaticResource TextToVisibility}}" />
                                    </StackPanel>
                                </styles:SHSubSection>
                            </StackPanel>
                        </styles:SHTabItem>
                    </styles:SHTabControl>
                </StackPanel>
            </styles:SHSection>
        </StackPanel>
    </ScrollViewer>
</UserControl>
